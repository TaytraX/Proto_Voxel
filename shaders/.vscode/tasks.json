{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Slang (Vertex)",
            "type": "shell",
            "command": "slangc",
            "args": [
                "$fileNameWithoutExt.slang",
                "-target",
                "spirv",
                "-profile",
                "vs_6_0",
                "-entry",
                "vsMain",
                "-o",
                "$fileNameWithoutExt_vert.spv"
            ],
            "group": "build"
        },
        {
            "label": "Build Slang (Fragment)",
            "type": "shell",
            "command": "slangc",
            "args": [
                "$fileNameWithoutExt.slang",
                "-target",
                "spirv",
                "-profile",
                "ps_6_0",
                "-entry",
                "psMain",
                "-o",
                "$fileNameWithoutExt_frag.spv"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}